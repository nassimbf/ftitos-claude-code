#!/bin/bash
# commit-msg gate for ftitos-claude-code.
#
# Separate from pre-commit because this check needs the message, and at
# pre-commit time it does not exist yet. git passes the message file as $1.
#
# Enforces the TDD rule that rules/workflow.md has always stated and nothing has
# ever checked: a commit claiming a behaviour change carries the test that would
# fail without it.

set -e
cd "$(git rev-parse --show-toplevel)"

if ! node scripts/ci/require-regression-test.js "$(pwd)" "$1"; then
  echo "BLOCKED: see above."
  exit 1
fi
